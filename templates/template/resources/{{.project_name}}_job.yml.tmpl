resources:
  jobs:
    {{.project_name}}_Job:
      permissions:
        - group_name: users
          level: CAN_VIEW
      name: {{.project_name}}_Job
      performance_target: STANDARD
      schedule:
        quartz_cron_expression: 0 45 * * * ? # Every hour at 45 minutes
        timezone_id: America/New_York
      tasks:
        - task_key: {{.project_name}}{{.data_source}}ToGold
          pipeline_task:
            pipeline_id:  ${resources.pipelines.{{.project_name}}_{{.data_source}}ToGold.id}
            full_refresh: false
      tags:
        Medallion_Architecture: true
        {{.data_domain}}: ""
        {{.project_name}}: ""
